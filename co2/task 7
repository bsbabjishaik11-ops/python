import time

calls = 0


# Original recursive program

def original(n):

    global calls
    calls += 1

    if n <= 1:
        return 1

    return original(n - 1) + original(n - 2)


# Redesigned iterative program

def redesigned(n):

    if n <= 1:
        return 1, 0

    a = 1
    b = 1
    operations = 0

    for i in range(2, n + 1):

        c = a + b
        a = b
        b = c

        operations += 1

    return b, operations


# Compare both programs

n = 30

calls = 0

start = time.perf_counter()
result1 = original(n)
time1 = time.perf_counter() - start

start = time.perf_counter()
result2, operations = redesigned(n)
time2 = time.perf_counter() - start


print("Original Result:", result1)
print("Original Function Calls:", calls)
print("Original Time:", time1, "seconds")

print("\nRedesigned Result:", result2)
print("Loop Operations:", operations)
print("Redesigned Time:", time2, "seconds")

print("\nResults Match:", result1 == result2)
