def add_item_buggy(item, order=[]):
    order.append(item)
    return order


def add_item(item, order=None):

    if order is None:
        order = []

    order.append(item)
    return order


print("Buggy Function:")
print(add_item_buggy("Tea"))
print(add_item_buggy("Vada"))

print("\nCorrect Function:")

customer1 = add_item("Tea")
customer2 = add_item("Vada")
customer3 = add_item("Coffee")

print("Customer 1:", customer1)
print("Customer 2:", customer2)
print("Customer 3:", customer3)


def calculate_bill(amount):

    gst = amount * 0.05
    total = amount + gst

    return total, gst


total, gst = calculate_bill(200)

print("Total:", total)
print("GST:", gst)


# Global and local scope

x = 100

def example():

    y = 50

    print("Global:", x)
    print("Local:", y)


example()


# Nonlocal scope

def outer():

    number = 10

    def inner():
        nonlocal number
        number = 20

    inner()
    print("Nonlocal:", number)


outer()
